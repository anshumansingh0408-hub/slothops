# SlothOps Environment Configuration

# Server Port
PORT=3001
VITE_API_URL=http://localhost:3001

# Core AI: Google Gemma / Open-Weight Models
# Choose your runtime: 'local-simulation', 'ollama', 'vllm', or 'huggingface'
GEMMA_RUNTIME=local-simulation
GEMMA_MODEL_NAME=google/gemma-2-9b-it
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Tabular Foundation Model: Prior Labs TabPFN-3.5
# Signs up free non-commercial license at platform.priorlabs.ai
TABPFN_MODE=hybrid
TABPFN_API_KEY=your_priorlabs_api_key_here
TABPFN_LOCAL_PYTHON=python

# Web Navigation: Browserbase (Stagehand SDK) & SerpApi
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here
SERPAPI_API_KEY=your_serpapi_key_here

# Voice Synthesis: ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Workflow Durability: Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Persistence & Vector Search: Tiger Data (PostgreSQL + pgvector) or MongoDB Atlas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slothops
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/slothops

# Identity & Security: Auth0 for AI Agents
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.slothops.local

# Observability: Sentry Agent Tracing
SENTRY_DSN=https://samplekey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=1.0
